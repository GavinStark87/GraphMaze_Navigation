        <Param name="storeCorrect" updates="constant" val="True" valType="bool"/>
        <Param name="syncScreenRefresh" updates="constant" val="True" valType="bool"/>
      </KeyboardComponent>
      <TextComponent name="number">
        <Param name="color" updates="constant" val="white" valType="str"/>
        <Param name="colorSpace" updates="constant" val="rgb" valType="str"/>
        <Param name="contrast" updates="constant" val="1" valType="num"/>
        <Param name="disabled" updates="None" val="False" valType="bool"/>
        <Param name="durationEstim" updates="None" val="" valType="code"/>
        <Param name="flip" updates="constant" val="" valType="str"/>
        <Param name="font" updates="constant" val="Times New Roman" valType="str"/>
        <Param name="languageStyle" updates="None" val="LTR" valType="str"/>
        <Param name="letterHeight" updates="constant" val="0.038" valType="code"/>
        <Param name="name" updates="None" val="number" valType="code"/>
        <Param name="opacity" updates="constant" val="1" valType="code"/>
        <Param name="ori" updates="constant" val="0" valType="code"/>
        <Param name="pos" updates="constant" val="(0, -0.36)" valType="code"/>
        <Param name="saveStartStop" updates="None" val="True" valType="bool"/>
        <Param name="startEstim" updates="None" val="" valType="code"/>
        <Param name="startType" updates="None" val="time (s)" valType="str"/>
        <Param name="startVal" updates="None" val="0.0" valType="code"/>
        <Param name="stopType" updates="None" val="duration (s)" valType="str"/>
        <Param name="stopVal" updates="constant" val="" valType="code"/>
        <Param name="syncScreenRefresh" updates="None" val="True" valType="bool"/>
        <Param name="text" updates="constant" val="Press 1, 2, 3, 4, or 5 on your keyboard." valType="extendedStr"/>
        <Param name="units" updates="None" val="from exp settings" valType="str"/>
        <Param name="wrapWidth" updates="constant" val="" valType="code"/>
      </TextComponent>
      <CodeComponent name="part2code">
        <Param name="Before Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Before JS Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Begin Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Begin JS Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Begin JS Routine" updates="constant" val="" valType="extendedCode"/>
        <Param name="Begin Routine" updates="constant" val="" valType="extendedCode"/>
        <Param name="Code Type" updates="None" val="Auto-&gt;JS" valType="str"/>
        <Param name="Each Frame" updates="constant" val="##Creating Clock&amp;#10;#timeRemaining = countdownClock.getTime()&amp;#10;#if timeRemaining &lt;=0.00:&amp;#10;#    continueRoutine = False&amp;#10;#    trials2.finished = True&amp;#10;#    countdownStarted = False&amp;#10;#    continueExperiment = True&amp;#10;#else:&amp;#10;#    minutes = int (timeRemaining/60.00)&amp;#10;#    seconds = int (timeRemaining - (minutes*60.00))&amp;#10;#    timeText = str(minutes) + ':'  + str(seconds) &amp;#10;&amp;#10;threshold = 180&amp;#10;time = myClock.getTime()&amp;#10;&amp;#10;if time &gt; threshold:&amp;#10;    continueRoutine = False " valType="extendedCode"/>
        <Param name="Each JS Frame" updates="constant" val="threshold = 180;&amp;#10;time = myClock.getTime();&amp;#10;if ((time &gt; threshold)) {&amp;#10;    continueRoutine = false;&amp;#10;}&amp;#10;" valType="extendedCode"/>
        <Param name="End Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="End JS Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="End JS Routine" updates="constant" val="" valType="extendedCode"/>
        <Param name="End Routine" updates="constant" val="" valType="extendedCode"/>
        <Param name="disabled" updates="None" val="False" valType="bool"/>
        <Param name="name" updates="None" val="part2code" valType="code"/>
      </CodeComponent>
    </Routine>
    <Routine name="instr">
      <ImageComponent name="instr_slides">
        <Param name="color" updates="constant" val="$[1,1,1]" valType="color"/>
        <Param name="colorSpace" updates="constant" val="rgb" valType="str"/>
        <Param name="contrast" updates="constant" val="1" valType="num"/>
        <Param name="disabled" updates="None" val="False" valType="bool"/>
        <Param name="durationEstim" updates="None" val="" valType="code"/>
        <Param name="flipHoriz" updates="constant" val="False" valType="bool"/>
        <Param name="flipVert" updates="constant" val="False" valType="bool"/>
        <Param name="image" updates="set every repeat" val="$'paperfolding_instr/Slide' + str(slideN) + '.png'" valType="file"/>
        <Param name="interpolate" updates="constant" val="linear" valType="str"/>
        <Param name="mask" updates="constant" val="" valType="str"/>
        <Param name="name" updates="None" val="instr_slides" valType="code"/>
        <Param name="opacity" updates="constant" val="" valType="num"/>
        <Param name="ori" updates="constant" val="0" valType="num"/>
        <Param name="pos" updates="constant" val="(0, 0)" valType="list"/>
        <Param name="saveStartStop" updates="None" val="True" valType="bool"/>
        <Param name="size" updates="constant" val="(1.6,0.9)" valType="list"/>
        <Param name="startEstim" updates="None" val="" valType="code"/>
        <Param name="startType" updates="None" val="time (s)" valType="str"/>
        <Param name="startVal" updates="None" val="0.0" valType="code"/>
        <Param name="stopType" updates="None" val="duration (s)" valType="str"/>
        <Param name="stopVal" updates="constant" val="" valType="code"/>
        <Param name="syncScreenRefresh" updates="None" val="True" valType="bool"/>
        <Param name="texture resolution" updates="constant" val="128" valType="num"/>
        <Param name="units" updates="None" val="from exp settings" valType="str"/>
      </ImageComponent>
      <KeyboardComponent name="instr_resp">
        <Param name="allowedKeys" updates="constant" val="'left','right','space'" valType="code"/>
        <Param name="correctAns" updates="constant" val="" valType="str"/>
        <Param name="disabled" updates="None" val="False" valType="bool"/>
        <Param name="discard previous" updates="constant" val="True" valType="bool"/>
        <Param name="durationEstim" updates="None" val="" valType="code"/>
        <Param name="forceEndRoutine" updates="constant" val="True" valType="bool"/>
        <Param name="name" updates="None" val="instr_resp" valType="code"/>
        <Param name="saveStartStop" updates="None" val="True" valType="bool"/>
        <Param name="startEstim" updates="None" val="" valType="code"/>
        <Param name="startType" updates="None" val="time (s)" valType="str"/>
        <Param name="startVal" updates="None" val="0.0" valType="code"/>
        <Param name="stopType" updates="None" val="duration (s)" valType="str"/>
        <Param name="stopVal" updates="constant" val="" valType="code"/>
        <Param name="store" updates="constant" val="nothing" valType="str"/>
        <Param name="storeCorrect" updates="constant" val="False" valType="bool"/>
        <Param name="syncScreenRefresh" updates="constant" val="True" valType="bool"/>
      </KeyboardComponent>
      <CodeComponent name="instr_code">
        <Param name="Before Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Before JS Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Begin Experiment" updates="constant" val="slideN = 1&amp;#10;&amp;#10;maxSlideN = 5&amp;#10;minSlideN = 1" valType="extendedCode"/>
        <Param name="Begin JS Experiment" updates="constant" val="slideN = 1;&amp;#10;maxSlideN = 5;&amp;#10;minSlideN = 1;&amp;#10;" valType="extendedCode"/>
        <Param name="Begin JS Routine" updates="constant" val="" valType="extendedCode"/>
        <Param name="Begin Routine" updates="constant" val="" valType="extendedCode"/>
        <Param name="Code Type" updates="None" val="Auto-&gt;JS" valType="str"/>
        <Param name="Each Frame" updates="constant" val="" valType="extendedCode"/>
        <Param name="Each JS Frame" updates="constant" val="" valType="extendedCode"/>
        <Param name="End Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="End JS Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="End JS Routine" updates="constant" val="if ((instr_resp.keys === &quot;left&quot;)) {&amp;#10;    slideN -= 1;&amp;#10;} else {&amp;#10;    if ((instr_resp.keys === &quot;right&quot;)) {&amp;#10;        slideN += 1;&amp;#10;    } else {&amp;#10;        if ((instr_resp.keys === &quot;space&quot;)) {&amp;#10;            if ((slideN === maxSlideN)) {&amp;#10;                instr_images.finished = true;&amp;#10;            }&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;if ((slideN &gt; maxSlideN)) {&amp;#10;    slideN = maxSlideN;&amp;#10;}&amp;#10;if ((slideN &lt; minSlideN)) {&amp;#10;    slideN = minSlideN;&amp;#10;}&amp;#10;" valType="extendedCode"/>
        <Param name="End Routine" updates="constant" val="if instr_resp.keys == 'left':&amp;#10;    slideN -= 1&amp;#10;elif instr_resp.keys == 'right':&amp;#10;    slideN += 1&amp;#10;elif instr_resp.keys == 'space':&amp;#10;    if slideN == maxSlideN:&amp;#10;        instr_images.finished = True&amp;#10;&amp;#10;if slideN &gt; maxSlideN:&amp;#10;    slideN = maxSlideN&amp;#10;if slideN &lt; minSlideN:&amp;#10;    slideN = minSlideN" valType="extendedCode"/>
        <Param name="disabled" updates="None" val="False" valType="bool"/>
        <Param name="name" updates="None" val="instr_code" valType="code"/>
      </CodeComponent>
    </Routine>
    <Routine name="post_sample_instr">
      <ImageComponent name="post_instr_slides">
        <Param name="color" updates="constant" val="$[1,1,1]" valType="color"/>
        <Param name="colorSpace" updates="constant" val="rgb" valType="str"/>
        <Param name="contrast" updates="constant" val="1" valType="num"/>
        <Param name="disabled" updates="None" val="False" valType="bool"/>
        <Param name="durationEstim" updates="None" val="" valType="code"/>
        <Param name="flipHoriz" updates="constant" val="False" valType="bool"/>
        <Param name="flipVert" updates="constant" val="False" valType="bool"/>
        <Param name="image" updates="set every repeat" val="$'paperfolding_post_instr/Slide' + str(postslideN) + '.png'" valType="file"/>
        <Param name="interpolate" updates="constant" val="linear" valType="str"/>
        <Param name="mask" updates="constant" val="" valType="str"/>
        <Param name="name" updates="None" val="post_instr_slides" valType="code"/>
        <Param name="opacity" updates="constant" val="" valType="num"/>
        <Param name="ori" updates="constant" val="0" valType="num"/>
        <Param name="pos" updates="constant" val="(0, 0)" valType="list"/>
        <Param name="saveStartStop" updates="None" val="True" valType="bool"/>
        <Param name="size" updates="constant" val="(1.6,0.9)" valType="list"/>
        <Param name="startEstim" updates="None" val="" valType="code"/>
        <Param name="startType" updates="None" val="time (s)" valType="str"/>
        <Param name="startVal" updates="None" val="0.0" valType="code"/>
        <Param name="stopType" updates="None" val="duration (s)" valType="str"/>
        <Param name="stopVal" updates="constant" val="" valType="code"/>
        <Param name="syncScreenRefresh" updates="None" val="True" valType="bool"/>
        <Param name="texture resolution" updates="constant" val="128" valType="num"/>
        <Param name="units" updates="None" val="from exp settings" valType="str"/>
      </ImageComponent>
      <KeyboardComponent name="post_instr_resp">
        <Param name="allowedKeys" updates="constant" val="'left','right','space'" valType="code"/>
        <Param name="correctAns" updates="constant" val="" valType="str"/>
        <Param name="disabled" updates="None" val="False" valType="bool"/>
        <Param name="discard previous" updates="constant" val="True" valType="bool"/>
        <Param name="durationEstim" updates="None" val="" valType="code"/>
        <Param name="forceEndRoutine" updates="constant" val="True" valType="bool"/>
        <Param name="name" updates="None" val="post_instr_resp" valType="code"/>
        <Param name="saveStartStop" updates="None" val="True" valType="bool"/>
        <Param name="startEstim" updates="None" val="" valType="code"/>
        <Param name="startType" updates="None" val="time (s)" valType="str"/>
        <Param name="startVal" updates="None" val="0.0" valType="code"/>
        <Param name="stopType" updates="None" val="duration (s)" valType="str"/>
        <Param name="stopVal" updates="constant" val="" valType="code"/>
        <Param name="store" updates="constant" val="nothing" valType="str"/>
        <Param name="storeCorrect" updates="constant" val="False" valType="bool"/>
        <Param name="syncScreenRefresh" updates="constant" val="True" valType="bool"/>
      </KeyboardComponent>
      <CodeComponent name="post_instr_code">
        <Param name="Before Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Before JS Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Begin Experiment" updates="constant" val="postslideN = 1&amp;#10;&amp;#10;postmaxSlideN = 6&amp;#10;minSlideN = 1" valType="extendedCode"/>
        <Param name="Begin JS Experiment" updates="constant" val="postslideN = 1;&amp;#10;postmaxSlideN = 6;&amp;#10;minSlideN = 1;&amp;#10;" valType="extendedCode"/>
        <Param name="Begin JS Routine" updates="constant" val="" valType="extendedCode"/>
        <Param name="Begin Routine" updates="constant" val="" valType="extendedCode"/>
        <Param name="Code Type" updates="None" val="Auto-&gt;JS" valType="str"/>
        <Param name="Each Frame" updates="constant" val="" valType="extendedCode"/>
        <Param name="Each JS Frame" updates="constant" val="" valType="extendedCode"/>
        <Param name="End Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="End JS Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="End JS Routine" updates="constant" val="if ((post_instr_resp.keys === &quot;left&quot;)) {&amp;#10;    postslideN -= 1;&amp;#10;} else {&amp;#10;    if ((post_instr_resp.keys === &quot;right&quot;)) {&amp;#10;        postslideN += 1;&amp;#10;    } else {&amp;#10;        if ((post_instr_resp.keys === &quot;space&quot;)) {&amp;#10;            if ((postslideN === postmaxSlideN)) {&amp;#10;                post_sample_instr_images.finished = true;&amp;#10;            }&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;if ((postslideN &gt; postmaxSlideN)) {&amp;#10;    postslideN = postmaxSlideN;&amp;#10;}&amp;#10;if ((postslideN &lt; minSlideN)) {&amp;#10;    postslideN = minSlideN;&amp;#10;}&amp;#10;" valType="extendedCode"/>
        <Param name="End Routine" updates="constant" val="if post_instr_resp.keys == 'left':&amp;#10;    postslideN -= 1&amp;#10;elif post_instr_resp.keys == 'right':&amp;#10;    postslideN += 1&amp;#10;elif post_instr_resp.keys == 'space':&amp;#10;    if postslideN == postmaxSlideN:&amp;#10;        post_sample_instr_images.finished = True&amp;#10;&amp;#10;if postslideN &gt; postmaxSlideN:&amp;#10;    postslideN = postmaxSlideN&amp;#10;if postslideN &lt; minSlideN:&amp;#10;    postslideN = minSlideN" valType="extendedCode"/>
        <Param name="disabled" updates="None" val="False" valType="bool"/>
        <Param name="name" updates="None" val="post_instr_code" valType="code"/>
      </CodeComponent>
    </Routine>
  </Routines>
  <Flow>
    <LoopInitiator loopType="TrialHandler" name="instr_images">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="None" valType="str"/>
      <Param name="conditionsFile" updates="None" val="" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="False" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="1000" valType="num"/>
      <Param name="name" updates="None" val="instr_images" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="instr"/>
    <LoopTerminator name="instr_images"/>
    <Routine name="sample_trial"/>
    <LoopInitiator loopType="TrialHandler" name="post_sample_instr_images">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="None" valType="str"/>
      <Param name="conditionsFile" updates="None" val="" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="False" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="1000" valType="num"/>
      <Param name="name" updates="None" val="post_sample_instr_images" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="post_sample_instr"/>
    <LoopTerminator name="post_sample_instr_images"/>
    <LoopInitiator loopType="TrialHandler" name="trials">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'ImageFile': 'paperfolding_stim_1/q1.png', 'corrAns': 1}, {'ImageFile': 'paperfolding_stim_1/q2.png', 'corrAns': 4}, {'ImageFile': 'paperfolding_stim_1/q3.png', 'corrAns': 2}, {'ImageFile': 'paperfolding_stim_1/q4.png', 'corrAns': 4}, {'ImageFile': 'paperfolding_stim_1/q5.png', 'corrAns': 2}, {'ImageFile': 'paperfolding_stim_1/q6.png', 'corrAns': 5}, {'ImageFile': 'paperfolding_stim_1/q7.png', 'corrAns': 1}, {'ImageFile': 'paperfolding_stim_1/q8.png', 'corrAns': 3}, {'ImageFile': 'paperfolding_stim_1/q9.png', 'corrAns': 5}, {'ImageFile': 'paperfolding_stim_1/q10.png', 'corrAns': 5}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="Images_and_corrAns_Part_1.xlsx" valType="str"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="code"/>
      <Param name="name" updates="None" val="trials" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="test_trial1"/>
    <LoopTerminator name="trials"/>
    <Routine name="intermission"/>
    <LoopInitiator loopType="TrialHandler" name="trials_2">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'ImageFile': 'paperfolding_stim_2/q11.png', 'corrAns': 3}, {'ImageFile': 'paperfolding_stim_2/q12.png', 'corrAns': 2}, {'ImageFile': 'paperfolding_stim_2/q13.png', 'corrAns': 1}, {'ImageFile': 'paperfolding_stim_2/q14.png', 'corrAns': 5}, {'ImageFile': 'paperfolding_stim_2/q15.png', 'corrAns': 2}, {'ImageFile': 'paperfolding_stim_2/q16.png', 'corrAns': 1}, {'ImageFile': 'paperfolding_stim_2/q17.png', 'corrAns': 5}, {'ImageFile': 'paperfolding_stim_2/q18.png', 'corrAns': 4}, {'ImageFile': 'paperfolding_stim_2/q19.png', 'corrAns': 4}, {'ImageFile': 'paperfolding_stim_2/q20.png', 'corrAns': 3}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="Images_and_corrAns_Part_2.xlsx" valType="str"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="code"/>
      <Param name="name" updates="None" val="trials_2" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="test_trial2"/>
    <LoopTerminator name="trials_2"/>
    <Routine name="end"/>
  </Flow>
</PsychoPy2experiment>
