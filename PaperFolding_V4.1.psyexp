      <CodeComponent name="part1code">
        <Param name="Before Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Before JS Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Begin Experiment" updates="constant" val="countdownStarted = False" valType="extendedCode"/>
        <Param name="Begin JS Experiment" updates="constant" val="countdownStarted = false;&amp;#10;" valType="extendedCode"/>
        <Param name="Begin JS Routine" updates="constant" val="if ((! countdownStarted)) {&amp;#10;    countdownClock = new core.CountdownTimer(180.0);&amp;#10;    countdownStarted = true;&amp;#10;}&amp;#10;" valType="extendedCode"/>
        <Param name="Begin Routine" updates="constant" val="#Setting Clock&amp;#10;if not countdownStarted:&amp;#10;    countdownClock = core.CountdownTimer(180.0)&amp;#10;    countdownStarted = True" valType="extendedCode"/>
        <Param name="Code Type" updates="None" val="Auto-&gt;JS" valType="str"/>
        <Param name="Each Frame" updates="constant" val="#Establishing and Displaying Timer&amp;#10;timeRemaining = countdownClock.getTime()&amp;#10;if timeRemaining &lt;=0.00:&amp;#10;    continueRoutine = False&amp;#10;    trials.finished = True&amp;#10;    countdownStarted = False&amp;#10;    continueExperiment = True&amp;#10;else:&amp;#10;    minutes = int (timeRemaining/60.00)&amp;#10;    seconds = int (timeRemaining - (minutes*60.00))&amp;#10;    timeText = str(minutes) + ':'  + str(seconds) &amp;#10;&amp;#10;    " valType="extendedCode"/>
        <Param name="Each JS Frame" updates="constant" val="timeRemaining = countdownClock.getTime();&amp;#10;if ((timeRemaining &lt;= 0.0)) {&amp;#10;    continueRoutine = false;&amp;#10;    trials.finished = true;&amp;#10;    countdownStarted = false;&amp;#10;    continueExperiment = true;&amp;#10;} else {&amp;#10;    minutes = Number.parseInt((timeRemaining / 60.0));&amp;#10;    seconds = Number.parseInt((timeRemaining - (minutes * 60.0)));&amp;#10;    timeText = ((minutes.toString() + &quot;:&quot;) + seconds.toString());&amp;#10;}&amp;#10;" valType="extendedCode"/>
        <Param name="End Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="End JS Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="End JS Routine" updates="constant" val="" valType="extendedCode"/>
        <Param name="End Routine" updates="constant" val="" valType="extendedCode"/>
        <Param name="disabled" updates="None" val="False" valType="bool"/>
        <Param name="name" updates="None" val="part1code" valType="code"/>
      </CodeComponent>
    </Routine>
